<?xml version="1.0" encoding="utf-8"?>
<!-- No packages are used (BCL only); this exists so restore can fetch the
     .NET runtime packs needed for self-contained publishing. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
